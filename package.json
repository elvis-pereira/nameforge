{
	"private": true,
	"name": "@elvispereira/nameforge",
	"version": "1.0.0",
	"description": "Machine learning-assisted random name generator.",
	"type": "module",
	"scripts": {
		"build": "bun build src/module.js src/worker.js --production --keep-names --splitting --outdir=dist",
		"dev": "bun build src/module.js src/worker.js --watch --outdir=dist",
		"package": "node scripts/package.js",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"author": "Elvis Pereira",
	"license": "Apache-2.0",
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@semantic-release/commit-analyzer": "^9.0.2",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/gitlab": "^9.5.1",
		"adm-zip": "^0.5.10",
		"conventional-changelog-conventionalcommits": "^5.0.0",
		"semantic-release": "^19.0.5"
	},
	"dependencies": {
		"brain.js": "2.0.0-beta.23",
		"gpu.js": "1.10.4"
	}
}
